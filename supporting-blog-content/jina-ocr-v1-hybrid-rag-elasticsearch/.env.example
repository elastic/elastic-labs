# Elasticsearch serverless cluster URL here
ELASTICSEARCH_URL=https://your-project.es.us-east-1.aws.elastic.cloud:443

# API Key (needs index read/write + inference privileges)
ELASTICSEARCH_API_KEY=your-api-key

# Elasticsearch index for the plant product catalog
ELASTICSEARCH_INDEX=texas_natives

# Port the Express server listens on (Vite proxies /api → this port)
PORT=3001

# --- Document OCR + RAG chat ---
# EIS endpoint used to parse uploaded documents (from your Elastic inference page)
OCR_INFERENCE_ID=.jina-ocr-v1-chat_completion
# Parallel OCR calls per upload; lower if you hit EIS 429s
OCR_CONCURRENCY=4
# Chat LLM for grounded answers (preconfigured on Elastic Inference Service).
# Use the chat_completion endpoint, not the plain completion one.
LLM_INFERENCE_ID=.anthropic-claude-4.5-haiku-chat_completion
