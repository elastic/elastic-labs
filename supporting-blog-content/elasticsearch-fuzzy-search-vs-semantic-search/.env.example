ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# API key with the privileges listed in the first cell of the notebook (typo-* indices, synonyms, inference).
# Kibana > Stack Management > API keys, or Dev Tools > POST /_security/api_key
ELASTICSEARCH_API_KEY="your-api-key"
