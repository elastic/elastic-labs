# Elasticsearch endpoint of a TEST cluster (Elastic Cloud Hosted or self-managed 9.5+, not Serverless)
ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# API key with the `monitor` cluster privilege and `all` on `audit-*`.
# Create it in Kibana Dev Tools with the request shown in the notebook's first cell.
ELASTICSEARCH_API_KEY="your-api-key"
