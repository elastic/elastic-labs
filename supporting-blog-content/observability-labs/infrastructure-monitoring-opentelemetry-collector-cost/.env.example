ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"
# Superuser API key (see the notebook's first cell)
ELASTICSEARCH_API_KEY="your-api-key"
# Managed OTLP endpoint and the collectors' ingest API key
ELASTIC_OTLP_ENDPOINT="https://your-deployment.ingest.region.cloud.es.io:443"
ELASTIC_INGEST_API_KEY="your-ingest-api-key"

# layout:interval runs, comma-separated, or "all" for the article's nine runs
LAB_RUNS="2:60"
# Suffix for the run namespaces (l2s60 -> l2s60b) if those data streams already exist
RUN_SUFFIX=""
WARMUP_SECONDS="180"
MEASURE_SECONDS="720"
LATENCY_REPS="15"
WORKERS="20"
KIND_CLUSTER="infra-cost"
KEEP_KIND_CLUSTER="false"
# "true" to measure synthetic _source in a local Elasticsearch trial (Docker, 6 GiB)
RUN_SYNTHETIC="false"
SYNTHETIC_PORT="9200"
