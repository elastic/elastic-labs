ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Elastic Agent image tag to run in Docker. 9.4.0 or later.
AGENT_VERSION="9.5.3"

# Minutes of PetClinic traffic to generate. Four minutes gives a few clear one-minute buckets.
TRAFFIC_MINUTES="4"
