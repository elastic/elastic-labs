FROM logs.otel.*
| EVAL message = COALESCE(attributes.event, CONCAT(attributes.http.request.method, " ", attributes.url.original))
| STATS lines = COUNT(*), raw_mb = ROUND(SUM(LENGTH(body.text)) / 1048576.0, 1)
    BY pattern = CATEGORIZE(message, {"output_format": "tokens"})
| SORT raw_mb DESC
| LIMIT 8
