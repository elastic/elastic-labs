# Elasticsearch endpoint, used by the collector and the scripts
ELASTIC_ENDPOINT=https://<your-deployment>.es.<region>.cloud.es.io
# Kibana URL, used by the Streams scripts (Kibana Streams API)
KIBANA_URL=https://<your-deployment>.kb.<region>.cloud.es.io
# API key (base64) with write access to logs.otel* and manage rights for ILM, indices and Streams
ELASTIC_API_KEY=<base64 api key>
