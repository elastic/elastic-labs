ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# Superuser API key. Kibana > Stack Management > API keys, or
# https://<your-kibana-host>/app/management/security/api_keys
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Optional. The collector's restricted API key (create_doc + auto_configure on
# logs-audit_demo.otel-lab). Leave it out and step 4 of the notebook creates one.
# COLLECTOR_API_KEY="collector-api-key"

# EDOT Collector image tag to run in Docker. 9.5.0 or later.
COLLECTOR_VERSION="9.5.3"

# Snapshot repository. Elastic Cloud Hosted deployments ship with found-snapshots.
SNAPSHOT_REPOSITORY="found-snapshots"
