ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# Create it in Kibana Dev Tools with "role_descriptors": {} so it keeps your user's Elasticsearch
# and Kibana privileges (ML jobs, alerting rules, dashboards).
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Must match k8s/ (cluster name from values-node-pressure.yaml, worker node, probe test-id).
LAB_CLUSTER_NAME="node-pressure-v2"
LAB_NODE_NAME="node-pressure-v2-worker"
LAB_TEST_ID="node-pressure-v2"

# Names of the ML job and the rules this notebook creates (Clean up deletes exactly these).
LAB_JOB_ID="node-pressure-memory-v2"

# Soft eviction threshold of the worker (k8s/kind-config.yaml) and the headroom alert level, in GiB.
LAB_EVICTION_GIB="6"
LAB_HEADROOM_GIB="6.5"

# Scenario window for the triage and timeline sections: the last LAB_WINDOW_MINUTES minutes,
# or the fixed UTC range if both bounds are set (ISO 8601, e.g. 2026-09-19T20:50:00Z).
LAB_WINDOW_MINUTES="60"
LAB_RANGE_FROM=""
LAB_RANGE_TO=""

# Optional: start the anomaly detection datafeed here instead of at the first node sample
# (ISO 8601 UTC). Set it when you recreate the cluster with the same name.
LAB_BASELINE_FROM=""
