# Copy to lab.env. Endpoint and key from Kibana > Add data > Kubernetes > OpenTelemetry.
# The key needs the apm event:write privilege ("Create key" on that page adds it).
ELASTIC_OTLP_ENDPOINT="https://your-project.ingest.region.elastic.cloud"
ELASTIC_API_KEY="your-api-key"
# Chart version and values URL shown on that same page for your stack version.
KUBE_STACK_VERSION="0.16.0"
EDOT_VALUES_URL="https://raw.githubusercontent.com/elastic/elastic-agent/v9.5.4/deploy/helm/edot-collector/kube-stack/managed_otlp/values.yaml"
TEST_ID="node-pressure-v2"
PROBE_DURATION="3h"
