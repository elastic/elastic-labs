ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# API key created by a superuser. Kibana > Stack Management > API keys, or
# https://<your-kibana-host>/app/management/security/api_keys
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"
# Start time you passed to the lab's scenario.py (UTC). The fault windows are computed from it.
LAB_T0="2026-11-15T00:00:00Z"
# TIME_SCALE you gave scenario.py, if you ran a shortened schedule.
LAB_TIME_SCALE="1"
# Data stream namespace the lab's collector writes to (resource/namespace processor).
LAB_NAMESPACE="dem"
# Monitor ID of the pushed Synthetics journey (Synthetics > Management > the monitor > ID).
SYNTHETICS_MONITOR_ID="dem-checkout-journey-bean-box-dem-default"
