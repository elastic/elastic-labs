ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# Create it in Kibana Dev Tools with "role_descriptors": {} so it keeps your user's privileges.
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"

# Managed OTLP endpoint of the same deployment. OTLP_API_KEY defaults to ELASTICSEARCH_API_KEY.
OTLP_ENDPOINT="https://your-managed-otlp-endpoint:443"
OTLP_API_KEY=""

OPENROUTER_API_KEY="sk-or-v1-your-key"
SMALL_MODEL="openai/gpt-5.6-luna"
LARGE_MODEL="openai/gpt-5.6-sol"

# .elser-2-elastic runs on the Elastic Inference Service; use .elser-2-elasticsearch for ML nodes.
INFERENCE_ID=".elser-2-elastic"

LAB_RUNSET="shopping-model-swap"
LAB_REPEATS="3"
