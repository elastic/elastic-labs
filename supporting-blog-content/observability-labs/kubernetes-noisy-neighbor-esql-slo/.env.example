ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# Needs read on metrics-*.otel-* and SLO write in Kibana.
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Must match k8s/ (cluster name, worker node, probe test-id).
LAB_CLUSTER_NAME="noisy-neighbor"
LAB_NODE_NAME="noisy-neighbor-worker"
LAB_TEST_ID="noisy-neighbor-final"

# Queries use the last LAB_WINDOW_MINUTES minutes, or the fixed UTC range if both are set.
LAB_WINDOW_MINUTES="2"
LAB_RANGE_FROM=""
LAB_RANGE_TO=""
