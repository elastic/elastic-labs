ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# API key created by a superuser. Kibana > Stack Management > API keys, or
# https://<your-kibana-host>/app/management/security/api_keys
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Window the queries run over, the same filter Discover's time picker applies.
# The defaults cover the article's run. For your own run, end LAB_END about an hour after the
# last incident: alert documents keep updating their @timestamp after they recover.
LAB_START="2026-10-18T20:00:00Z"
LAB_END="2026-10-19T01:00:00Z"

# Versions whose alert no deployment caused (comma-separated SHA prefixes). In your own run,
# use live_sha from payments_outage_start in scenario-events.jsonl.
OUTAGE_VERSIONS="b52b78f"
