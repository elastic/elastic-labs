ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io:443"
# Create it in Kibana Dev Tools with "role_descriptors": {} so it keeps your user's privileges.
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# EDOT Collector image tag (docker.elastic.co/elastic-agent/elastic-agent). Use your stack version.
STACK_VERSION="9.5.4"
