# Elasticsearch and Kibana of an Elastic Cloud Hosted 9.5+ deployment. The notebook runs ES|QL and
# calls the Agent Builder, Workflows and connector APIs with this key, so create it as a user that
# can use all three (for example: POST /_security/api_key with "role_descriptors": {}).
ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"

# Managed OTLP endpoint for k8s/lab.sh (Kibana > Add data > Kubernetes > OpenTelemetry).
# The collector authenticates with ELASTICSEARCH_API_KEY unless you set ELASTIC_OTLP_API_KEY.
OTLP_ENDPOINT="https://your-deployment.ingest.region.cloud.es.io:443"
# ELASTIC_OTLP_API_KEY="optional-ingest-only-key"

# Optional overrides for k8s/lab.sh.
# KUBE_STACK_VERSION="0.16.0"
# EDOT_VALUES_URL="https://raw.githubusercontent.com/elastic/elastic-agent/refs/tags/v9.5.5/deploy/helm/edot-collector/kube-stack/managed_otlp/values.yaml"

# k8s/lab.sh appends the lab times (LAB_*) and the tunnel URL below this line.
