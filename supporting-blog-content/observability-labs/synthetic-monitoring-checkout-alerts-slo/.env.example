ELASTICSEARCH_URL="https://your-deployment.es.region.cloud.es.io"
# API key created by a superuser with no role descriptors (Fleet, Synthetics, alerting,
# maintenance windows, SLOs, read .alerts-*). Kibana > Stack Management > API keys.
ELASTICSEARCH_API_KEY="your-api-key"
KIBANA_URL="https://your-deployment.kb.region.cloud.es.io"
KIBANA_SPACE="default"

# Optional: project API key from Synthetics > Settings > Project API keys.
# Leave empty to push the monitors with ELASTICSEARCH_API_KEY.
SYNTHETICS_API_KEY=""

# Where you deployed app/ (Bean Box). The managed locations must reach both.
SHOP_URL="https://your-bean-box-host.example.com"
# Public host:port that forwards to the app's GATEWAY_PORT (the TCP payment gateway).
GATEWAY_ADDRESS="your-tcp-proxy.example.net:12345"
# The CHAOS_TOKEN you started the app with.
CHAOS_TOKEN="the-token-you-started-the-app-with"

# Optional: public IP the app sees for this machine (the Private Location agent runs here).
# Leave empty to ask the app (GET /__whoami).
OFFICE_IP=""
# Optional: Fleet Server URL. Leave empty to use the default Fleet Server host.
FLEET_URL=""
# Optional: minutes between creating the maintenance window and the start of the replayed week.
LEAD_MINUTES="10"
