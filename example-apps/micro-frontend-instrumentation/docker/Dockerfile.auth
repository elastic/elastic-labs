FROM node:20-alpine AS build
WORKDIR /app

COPY package.json ./
COPY packages/contracts ./packages/contracts
COPY packages/webpack-shared ./packages/webpack-shared
COPY packages/auth ./packages/auth

RUN npm install
RUN npm run build -w @mfe/contracts

ARG PUBLIC_PATH=http://localhost:3001/
ARG AUTH_API_URL=http://localhost:4000
ENV PUBLIC_PATH=$PUBLIC_PATH
ENV AUTH_API_URL=$AUTH_API_URL

RUN npm run build -w @mfe/auth

FROM nginx:1.27-alpine
COPY packages/auth/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/auth/dist /usr/share/nginx/html