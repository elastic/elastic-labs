FROM node:20-alpine AS build
WORKDIR /app

COPY package.json ./
COPY packages/webpack-shared ./packages/webpack-shared
COPY packages/contracts ./packages/contracts
COPY packages/dashboard ./packages/dashboard

RUN npm install

ARG PUBLIC_PATH=http://localhost:3002/
ENV PUBLIC_PATH=$PUBLIC_PATH

RUN npm run build -w @mfe/contracts
RUN npm run build -w @mfe/dashboard

FROM nginx:1.27-alpine
COPY packages/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/dashboard/dist /usr/share/nginx/html