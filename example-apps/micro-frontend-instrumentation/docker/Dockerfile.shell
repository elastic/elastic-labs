FROM node:20-alpine AS build
WORKDIR /app

COPY package.json ./
COPY packages/webpack-shared ./packages/webpack-shared
COPY packages/shell ./packages/shell

RUN npm install

ARG PUBLIC_PATH=http://localhost:3000/
ARG AUTH_REMOTE_URL=http://localhost:3001/remoteEntry.js
ARG DASHBOARD_REMOTE_URL=http://localhost:3002/remoteEntry.js

ENV PUBLIC_PATH=$PUBLIC_PATH
ENV AUTH_REMOTE_URL=$AUTH_REMOTE_URL
ENV DASHBOARD_REMOTE_URL=$DASHBOARD_REMOTE_URL

RUN npm run build -w @mfe/shell

FROM nginx:1.27-alpine
COPY packages/shell/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/shell/dist /usr/share/nginx/html