{
  "name": "elaspic",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "ui",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:ui": "npm run build --workspace=elaspic-ui",
    "dev:ui": "npm run dev --workspace=elaspic-ui"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@elastic/eui": "^95.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/css": "^11.13.5"
  }
}