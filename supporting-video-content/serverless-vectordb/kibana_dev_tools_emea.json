####  5. Multimodal search with the semantic field  ##########

# Text -> image: describe a shape, find the matching logo.
POST elastic-catalog/_search
{
  "_source": ["product_id", "name"],
  "size": 3,
  "query": {
    "match": { "logo": "a logo shaped like a shield" }
  }
}

# Image -> product: "which product has this logo?" - search
# with a logo image instead of text.
POST elastic-catalog/_search
{
  "_source": ["product_id", "name"],
  "size": 3,
  "query": {
    "knn": {
      "field": "logo",
      "k": 3,
      "num_candidates": 20,
      "query_vector_builder": {
        "embedding": {
          "input": {
            "type": "image",
            "value": "data:image/png;base64,"
          }
        }
      }
    }
  }
}


####  6. Hybrid search  ######################################

# Exact terms like "SIEM" are where keyword search shines, and
# meaning is where semantic shines. The linear retriever runs
# both queries, normalizes each score to 0-1 (minmax), applies a
# weight, and adds them up. Elastic Security matches on both.
POST elastic-catalog/_search
{
  "_source": ["name"],
  "size": 3,
  "retriever": {
    "linear": {
      "retrievers": [
        {
          "retriever": {
            "standard": {
              "query": { "match": { "description": "SIEM threat detection" } }
            }
          },
          "weight": 1.0,
          "normalizer": "minmax"
        },
        {
          "retriever": {
            "standard": {
              "query": { "match": { "description_semantic": "SIEM threat detection" } }
            }
          },
          "weight": 1.0,
          "normalizer": "minmax"
        }
      ]
    }
  }
}


####  7. Agent Builder: ES|QL tools  #########################

# Tool 1: hybrid search over the catalog
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-search",
  "type": "esql",
  "description": "Search the Elastic product catalog with hybrid (keyword + semantic) search. Use for any question about what a product does or which product fits a use case.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog METADATA _id, _index, _score
| FORK (WHERE MATCH(description, ?query) | SORT _score DESC | LIMIT 20)
       (WHERE MATCH(description_semantic, ?query) | SORT _score DESC | LIMIT 20)
| KEEP _id, _index, _score, _fork, product_id, name, category, tags, description, logo_url
| FUSE
| SORT _score DESC
| KEEP product_id, name, category, tags, description, logo_url
| LIMIT 5
""",
    "params": {
      "query": {
        "type": "string",
        "description": "The user's need or question about Elastic products, in natural language"
      }
    }
  }
}

# Tool 2: exact lookup by tag or category
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-lookup-by-tag",
  "type": "esql",
  "description": "Look up Elastic products by an exact tag or category, such as 'siem' or 'observability'.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog
| WHERE MATCH(tags, ?tag) OR category == ?tag
| KEEP product_id, name, category, tags, description, logo_url
| LIMIT 10
""",
    "params": {
      "tag": {
        "type": "string",
        "description": "The exact tag or category to filter on, for example siem or observability"
      }
    }
  }
}

# Tool 3: what the catalog covers
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-overview",
  "type": "esql",
  "description": "List the categories covered by the Elastic product catalog with product counts.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog
| STATS products = COUNT(*), names = VALUES(name) BY category
| SORT products DESC
""",
    "params": {}
  }
}

####  7. Agent Builder: Agent  ###############################

POST kbn:/api/agent_builder/agents
{
  "id": "catalog-finder-agent",
  "name": "Elastic Product Finder",
  "description": "Recommends Elastic products and solutions from the catalog for a given use case.",
  "labels": ["catalog", "demo"],
  "avatar_color": "#BFDBFF",
  "avatar_symbol": "EF",
  "configuration": {
    "instructions": "You help people find the right Elastic product for a job, using only the product catalog. If the user names an exact tag or category, call catalog-lookup-by-tag first, then catalog-search for related options. Give a short recommendation with 1-2 sentences of reasoning and cite the product_id you used. When a product from the catalog is relevant to your answer, show its name and logo together as a Markdown image using its logo_url field, like ![Elastic Security](logo_url). Your tools can only match on product name, description, category and tags - they cannot search by what a logo looks like, so if asked to identify a product from a visual description of its logo, say that logo-shape search isn't something your tools support rather than guessing. If nothing in the catalog fits a request, say so plainly rather than guessing.",
    "tools": [
      {
        "tool_ids": [
          "catalog-search",
          "catalog-lookup-by-tag",
          "catalog-overview"
        ]
      }
    ]
  }
}

# Try the agent in the Kibana UI:
#   1. Click "AI Agent" at the top right of Kibana
#   2. Click the burger menu at the top left of the flyout
#   3. Click the name of the current agent, "Elastic AI Agent"
#   4. Select "Elastic Product Finder"
#   5. Ask a question in the chat
#
# Try asking:
#   - What's a good product for detecting threats in our network?
#   - I need to run my deployment without managing servers
#   - What categories of products do you have?
