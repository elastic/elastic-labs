####  4. Lexical vs semantic search  #########################

# Lexical search works when the words match. "SIEM" appears in
# the Security description, so BM25 finds it.
POST elastic-catalog/_search
{
  "_source": ["name"],
  "size": 3,
  "query": { "match": { "description": "SIEM" } }
}

# The same query against the semantic_text field also works.
POST elastic-catalog/_search
{
  "_source": ["name"],
  "size": 3,
  "query": { "match": { "description_semantic": "SIEM" } }
}

# Lexical search fails when the words differ. The user describes
# the need in their own words - nothing matches. 0 hits.
POST elastic-catalog/_search
{
  "_source": ["name"],
  "size": 3,
  "query": { "match": { "description": "catch an attacker moving through our network" } }
}

# Same question against semantic_text: matched by meaning.
# Elastic Security comes first. No query embedding to
# generate - Elasticsearch does it for you.
POST elastic-catalog/_search
{
  "_source": ["name"],
  "size": 3,
  "query": { "match": { "description_semantic": "catch an attacker moving through our network" } }
}

