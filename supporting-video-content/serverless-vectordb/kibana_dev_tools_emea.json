# Vector Search with Elasticsearch - Kibana Dev Tools Demo
#
# Environment: Elasticsearch Serverless, Vector Database project
# Scenario:    A catalog of Elastic products and solutions, each with
#              a short description.
#
# Run the requests from top to bottom. Every step is safe to re-run.
# Docs: https://www.elastic.co/docs/solutions/vector-database


####  0. Reset  ##############################################

# Start from a clean slate. On a fresh project these return
# 404 "not found" - that's expected and harmless. force=true
# drops the tool from any other agent that references it.
DELETE kbn:/api/agent_builder/agents/catalog-finder-agent
DELETE kbn:/api/agent_builder/tools/catalog-search?force=true
DELETE kbn:/api/agent_builder/tools/catalog-lookup-by-tag?force=true
DELETE kbn:/api/agent_builder/tools/catalog-overview?force=true
DELETE elastic-catalog?ignore_unavailable=true


####  1. Inference API: built-in models on EIS  ##############

# The Elastic Inference Service (EIS) comes with preconfigured,
# ready-to-use endpoints. No model deployment, no API keys.
GET _inference/_all?filter_path=endpoints.inference_id,endpoints.task_type

# Text -> embedding (a list of 1,024 numbers)
POST _inference/text_embedding/.jina-embeddings-v5-text-small
{
  "input": "a tool for building search experiences over your own content"
}

# Image -> embedding: a product logo
POST _inference/embedding/.jina-embeddings-v5-omni-small
{
  "input": [
    {
      "content": [
        {
          "type": "image",
          "format": "base64",
          "value": "data:image/png;base64,"
        }
      ]
    }
  ]
}


####  2. Index: Settings and mappings  #######################

# Every field gets an explicit type. That matters because real
# search apps rarely run a bare query - they mix relevance with
# filters ("only security products") and aggregations ("how many
# products per category?"). The type decides what each field
# can do:
#
#   product_id   keyword - exact value: filter, sort, aggregate,
#                          or use as a lookup key. Not analysed.
#   name         text    - analysed for full-text search
#   category     keyword - filter and facet counts (terms agg)
#   tags         keyword - same, and holds many values per doc
#   logo_url     keyword, index: false - kept for display only,
#                          not searchable, so no index overhead
#
# The semantic fields: one description, stored in different
# forms from ONE text field, plus the logo:
#   description          - text: analysed, for lexical (BM25) search.
#                          copy_to sends its value to the field below
#   description_semantic - semantic_text: Elasticsearch chunks and
#                          embeds the text for you
#   description_vector   - dense_vector: bring your own vectors.
#                          We pre-computed these with the call in
#                          step 1, like a developer who already has
#                          embeddings from their own pipeline
#   logo                 - semantic: same as semantic_text, but for
#                          any modality (here: images), using the
#                          built-in omni model
PUT elastic-catalog
{
  "mappings": {
    "properties": {
      "product_id":  { "type": "keyword" },
      "name":        { "type": "text" },
      "category":    { "type": "keyword" },
      "tags":        { "type": "keyword" },
      "logo_url":    { "type": "keyword", "index": false },
      "description": {
        "type": "text",
        "copy_to": "description_semantic"
      },
      "description_semantic": {
        "type": "semantic_text"
      },
      "description_vector": {
        "type": "dense_vector",
        "dims": 1024,
        "similarity": "cosine",
        "index_options": { "type": "bbq_disk" }
      },
      "logo": {
        "type": "semantic",
        "inference_id": ".jina-embeddings-v5-omni-small"
      }
    }
  }
}

# Vector Database projects use the vectordb_document index
# mode. It applies vector-tuned defaults, e.g. vectors are kept
# out of _source to save storage.
GET elastic-catalog/_settings?include_defaults=true&filter_path=**.mode,**.exclude_source_vectors


####  3. Load data  ##########################################

# Six Elastic products and solutions. description_vector is
# supplied by us (pre-computed); description_semantic and logo
# are embedded by Elasticsearch on ingest.
POST elastic-catalog/_bulk?refresh=wait_for&filter_path=errors,items.*.error
