# Vector Search with Elasticsearch - Kibana Dev Tools Demo
#
# Environment: Elasticsearch Serverless, Vector Database project
# Scenario:    A catalog of Elastic products and solutions, each with
#              a short description and its official logo.
#
# Run the requests from top to bottom. Every step is safe to re-run.
# Docs: https://www.elastic.co/docs/solutions/vector-database


####  0. Reset  ##############################################

# Start from a clean slate. On a fresh project these return
# 404 "not found" - that's expected and harmless. force=true
# drops the tool from any other agent that happens to reference
# the same tool_id, so this stays idempotent even then.
DELETE kbn:/api/agent_builder/agents/catalog-finder-agent
DELETE kbn:/api/agent_builder/tools/catalog-search?force=true
DELETE kbn:/api/agent_builder/tools/catalog-lookup-by-tag?force=true
DELETE kbn:/api/agent_builder/tools/catalog-overview?force=true
DELETE elastic-catalog?ignore_unavailable=true
DELETE _ingest/pipeline/catalog-embed-description
DELETE _inference/catalog-text-embeddings
DELETE _inference/catalog-multimodal-embeddings


####  1. Inference API: Models on EIS  #######################

# The Elastic Inference Service (EIS) comes with preconfigured,
# ready-to-use endpoints. No model deployment, no API keys.
GET _inference/_all?filter_path=endpoints.inference_id,endpoints.task_type

# Create our own endpoints for two of the Jina models we'll use,
# so we can give them memorable names.

# Jina Embeddings v5 Text: text in, 1,024-dim vector out
PUT _inference/text_embedding/catalog-text-embeddings
{
  "service": "elastic",
  "service_settings": { "model_id": "jina-embeddings-v5-text-small" }
}

# Jina Embeddings v5 Omni: text and images in, mapped into the
# same vector space. We'll use it on product logos.
PUT _inference/embedding/catalog-multimodal-embeddings
{
  "service": "elastic",
  "service_settings": { "model_id": "jina-embeddings-v5-omni-small" }
}


####  1. Inference API: Invoking models  #####################

# Text -> embedding (a list of 1,024 numbers)
POST _inference/text_embedding/catalog-text-embeddings
{
  "input": "a tool for building search experiences over your own content"
}

# Image -> embedding: a product logo
POST _inference/embedding/catalog-multimodal-embeddings
{
  "input": [
    {
      "content": [
        {
          "type": "image",
          "format": "base64",
          "value": "data:image/png;base64,"
        }
      ]
    }
  ]
}

# What do vectors buy us? Similar meaning = high cosine
# similarity, even with zero words in common.
POST _query?format=txt
{
  "query": """
ROW query = "a tool for building search experiences over your own content"
| EVAL same_meaning = V_COSINE(
         TEXT_EMBEDDING("a tool for building search experiences over your own content", "catalog-text-embeddings"),
         TEXT_EMBEDDING("connectors and retrieval for custom search applications", "catalog-text-embeddings")),
       different_topic = V_COSINE(
         TEXT_EMBEDDING("a tool for building search experiences over your own content", "catalog-text-embeddings"),
         TEXT_EMBEDDING("detecting threats and hunting adversaries", "catalog-text-embeddings"))
| KEEP query, same_meaning, different_topic
"""
}

# Same idea across modalities: text vs. a product logo
# (EMBEDDING is a preview function)
POST _query?format=txt
{
  "query": """
ROW logo = "Elastic Security logo"
| EVAL matching_text = V_COSINE(
         EMBEDDING("a shield representing threat detection and SIEM", "catalog-multimodal-embeddings"),
         EMBEDDING("data:image/png;base64,", "catalog-multimodal-embeddings", {"type": "image"})),
       unrelated_text = V_COSINE(
         EMBEDDING("a cloud representing managed hosting", "catalog-multimodal-embeddings"),
         EMBEDDING("data:image/png;base64,", "catalog-multimodal-embeddings", {"type": "image"}))
| KEEP logo, matching_text, unrelated_text
"""
}


####  2. Index: Embedding pipeline  ##########################

# "Bring your own vectors": an ingest pipeline that embeds each
# product's description into a plain dense_vector field.
PUT _ingest/pipeline/catalog-embed-description
{
  "description": "Embed the product description with Jina v5 Text",
  "processors": [
    {
      "inference": {
        "model_id": "catalog-text-embeddings",
        "input_output": [
          { "input_field": "description", "output_field": "description_vector" }
        ]
      }
    }
  ]
}


####  2. Index: Settings and mappings  #######################

# Three ways to store vectors, side by side:
#   description_vector  - dense_vector: you manage the embeddings
#   description_semantic - semantic_text: Elasticsearch chunks
#                           and embeds text for you
#   logo                  - semantic: same, but for any modality
PUT elastic-catalog
{
  "settings": {
    "index": {
      "mode": "vectordb_document",
      "default_pipeline": "catalog-embed-description"
    }
  },
  "mappings": {
    "properties": {
      "product_id":  { "type": "keyword" },
      "name":        { "type": "text" },
      "category":    { "type": "keyword" },
      "tags":        { "type": "keyword" },
      "logo_url":    { "type": "keyword", "index": false },
      "description": {
        "type": "text",
        "copy_to": "description_semantic"
      },
      "description_vector": {
        "type": "dense_vector",
        "dims": 1024,
        "similarity": "cosine",
        "index_options": {
          "type": "bbq_disk",
          "auto_calibrate": true
        }
      },
      "description_semantic": {
        "type": "semantic_text",
        "inference_id": "catalog-text-embeddings",
        "index_options": {
          "dense_vector": { "type": "bbq_disk" }
        }
      },
      "logo": {
        "type": "semantic",
        "inference_id": "catalog-multimodal-embeddings"
      }
    }
  }
}

# Vector Database projects use the vectordb_document index
# mode. It applies vector-tuned defaults, e.g. vectors are kept
# out of _source to save storage.
GET elastic-catalog/_settings?include_defaults=true&filter_path=**.mode,**.exclude_source_vectors

# DiskBBQ keeps compressed vectors on disk, not in RAM.
# auto_calibrate picks the cheapest encoding that reaches ~90%
# recall for each merged segment of 10,000+ vectors (so it
# won't kick in on this small demo). Note the bfloat16 default,
# applied automatically by vectordb_document mode.
GET elastic-catalog/_mapping?filter_path=**.description_vector


