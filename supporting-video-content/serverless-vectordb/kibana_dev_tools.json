####  4. Vector search with ES|QL  ###########################

# Baseline: keyword search. Incidental word overlap promotes
# the wrong products over the one the user actually needs
# (observability, for diagnosing a production incident).
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _score
| WHERE MATCH(description, "our production service is having problems and I need to find the cause")
| SORT _score DESC
| KEEP _score, product_id, name
| LIMIT 5
"""
}

# kNN on dense_vector: embed the question, find the nearest
# product vectors. observability jumps to the top.
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _score
| WHERE KNN(description_vector, TEXT_EMBEDDING("our production service is having problems and I need to find the cause", "catalog-text-embeddings"))
| SORT _score DESC
| KEEP _score, product_id, name
| LIMIT 5
"""
}

# Filtered kNN: metadata filters are applied during the vector
# search. visit_percentage is the DiskBBQ speed/recall knob.
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _score
| WHERE KNN(description_vector, TEXT_EMBEDDING("answer customer questions automatically using our own knowledge base", "catalog-text-embeddings"), {"visit_percentage": 10})
    AND category in ("ai", "search-applications")
| SORT _score DESC
| KEEP _score, product_id, category, name
| LIMIT 3
"""
}

# semantic_text: same result, much less work. No pipeline and
# no query embedding - just MATCH the field.
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _score
| WHERE MATCH(description_semantic, "our production service is having problems and I need to find the cause")
| SORT _score DESC
| KEEP _score, product_id, name
| LIMIT 5
"""
}

# The : operator is shorthand for MATCH. Combine with filters.
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _score
| WHERE description_semantic: "catch an attacker moving through our network" AND category == "security"
| SORT _score DESC
| KEEP _score, product_id, category, name
| LIMIT 3
"""
}


####  5. Multimodal search with the semantic field  ##########

# The semantic field is queried with Query DSL (ES|QL support
# isn't available yet - ES|QL's KNN() explicitly rejects
# "semantic" fields: "Cannot use field [logo] with unsupported
# type [semantic]"). Because Agent Builder's ES|QL tools can
# only run ES|QL, the catalog-finder-agent in section 7 cannot
# answer "which logo looks like X" - that's only possible here,
# directly against the index.

# Text -> image: describe a shape, find the matching logo.
POST elastic-catalog/_search
{
  "_source": ["product_id", "name"],
  "size": 3,
  "query": {
    "match": { "logo": "a logo shaped like a shield" }
  }
}

# Image -> product: "which product has this logo?" - search
# with a logo image instead of text.
POST elastic-catalog/_search
{
  "_source": ["product_id", "name"],
  "size": 3,
  "query": {
    "knn": {
      "field": "logo",
      "k": 3,
      "num_candidates": 20,
      "query_vector_builder": {
        "embedding": {
          "input": {
            "type": "image",
            "value": "data:image/png;base64,"
          }
        }
      }
    }
  }
}


####  6. Hybrid search with ES|QL  ###########################

# Exact terms like "SIEM" are where keyword search shines.
# FORK runs keyword and semantic search in parallel; FUSE merges
# them with Reciprocal Rank Fusion (RRF).
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _id, _index, _score
| FORK (WHERE MATCH(description, "SIEM threat detection") | SORT _score DESC | LIMIT 10)
       (WHERE MATCH(description_semantic, "SIEM threat detection") | SORT _score DESC | LIMIT 10)
| KEEP _id, _index, _score, _fork, product_id, name
| FUSE
| SORT _score DESC
| KEEP _score, product_id, name
| LIMIT 5
"""
}

# Linear combination: normalize both score ranges to 0-1, then
# weight them (here 30% keyword, 70% semantic).
POST _query?format=txt
{
  "query": """
FROM elastic-catalog METADATA _id, _index, _score
| FORK (WHERE MATCH(description, "SIEM threat detection") | SORT _score DESC | LIMIT 10)
       (WHERE MATCH(description_semantic, "SIEM threat detection") | SORT _score DESC | LIMIT 10)
| KEEP _id, _index, _score, _fork, product_id, name
| FUSE LINEAR WITH { "weights": { "fork1": 0.3, "fork2": 0.7 }, "normalizer": "minmax" }
| SORT _score DESC
| KEEP _score, product_id, name
| LIMIT 5
"""
}


####  7. Agent Builder: ES|QL tools  #########################

# Tool 1: hybrid search over the catalog
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-search",
  "type": "esql",
  "description": "Search the Elastic product catalog with hybrid (keyword + semantic) search. Use for any question about what a product does or which product fits a use case.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog METADATA _id, _index, _score
| FORK (WHERE MATCH(description, ?query) | SORT _score DESC | LIMIT 20)
       (WHERE MATCH(description_semantic, ?query) | SORT _score DESC | LIMIT 20)
| KEEP _id, _index, _score, _fork, product_id, name, category, tags, description, logo_url
| FUSE
| SORT _score DESC
| KEEP product_id, name, category, tags, description, logo_url
| LIMIT 5
""",
    "params": {
      "query": {
        "type": "string",
        "description": "The user's need or question about Elastic products, in natural language"
      }
    }
  }
}

# Tool 2: exact lookup by tag or category
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-lookup-by-tag",
  "type": "esql",
  "description": "Look up Elastic products by an exact tag or category, such as 'siem' or 'observability'.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog
| WHERE MATCH(tags, ?tag) OR category == ?tag
| KEEP product_id, name, category, tags, description, logo_url
| LIMIT 10
""",
    "params": {
      "tag": {
        "type": "string",
        "description": "The exact tag or category to filter on, for example siem or observability"
      }
    }
  }
}

# Tool 3: what the catalog covers
POST kbn:/api/agent_builder/tools
{
  "id": "catalog-overview",
  "type": "esql",
  "description": "List the categories covered by the Elastic product catalog with product counts.",
  "tags": ["catalog", "elastic"],
  "configuration": {
    "query": """
FROM elastic-catalog
| STATS products = COUNT(*), names = VALUES(name) BY category
| SORT products DESC
""",
    "params": {}
  }
}

# Try a tool directly, exactly as the agent will call it
POST kbn:/api/agent_builder/tools/_execute
{
  "tool_id": "catalog-search",
  "tool_params": { "query": "I want to let customers ask questions in natural language and get answers grounded in our data" }
}


####  7. Agent Builder: Agent  ###############################

POST kbn:/api/agent_builder/agents
{
  "id": "catalog-finder-agent",
  "name": "Elastic Product Finder",
  "description": "Recommends Elastic products and solutions from the catalog for a given use case.",
  "labels": ["catalog", "demo"],
  "avatar_color": "#BFDBFF",
  "avatar_symbol": "EF",
  "configuration": {
    "instructions": "You help people find the right Elastic product for a job, using only the product catalog. If the user names an exact tag or category, call catalog-lookup-by-tag first, then catalog-search for related options. Give a short recommendation with 1-2 sentences of reasoning and cite the product_id you used. When a product from the catalog is relevant to your answer, show its name and logo together as a Markdown image using its logo_url field, like ![Elastic Security](logo_url). Your tools can only match on product name, description, category and tags - they cannot search by what a logo looks like, so if asked to identify a product from a visual description of its logo, say that logo-shape search isn't something your tools support rather than guessing. If nothing in the catalog fits a request, say so plainly rather than guessing.",
    "tools": [
      {
        "tool_ids": [
          "catalog-search",
          "catalog-lookup-by-tag",
          "catalog-overview"
        ]
      }
    ]
  }
}

# Converse with the agent via API. The response shows which
# tools it called and the ES|QL results it based its answer on.
POST kbn:/api/agent_builder/converse
{
  "agent_id": "catalog-finder-agent",
  "input": "I want to let customers ask questions in natural language and get answers grounded in our data - what do you recommend?"
}

# Keep chatting in the UI (replace <kibana-url> with your
# project's Kibana URL):
# <kibana-url>/app/agent_builder/agents/catalog-finder-agent/conversations/new
#
# Try asking:
#   - What's a good product for detecting threats in our network?
#   - I need to run my deployment without managing servers
#   - What categories of products do you have?
